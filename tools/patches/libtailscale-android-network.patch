diff --git a/android_network.go b/android_network.go
new file mode 100644
index 0000000..21c0633
--- /dev/null
+++ b/android_network.go
@@ -0,0 +1,74 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/netip"
+
+	"tailscale.com/net/netmon"
+)
+
+type androidNetworkAddress struct {
+	IP        string `json:"ip"`
+	PrefixLen int    `json:"prefixLen"`
+}
+
+type androidNetworkInterface struct {
+	Name         string                  `json:"name"`
+	Index        int                     `json:"index"`
+	MTU          int                     `json:"mtu"`
+	Up           bool                    `json:"up"`
+	Broadcast    bool                    `json:"broadcast"`
+	Loopback     bool                    `json:"loopback"`
+	PointToPoint bool                    `json:"pointToPoint"`
+	Multicast    bool                    `json:"multicast"`
+	Addrs        []androidNetworkAddress `json:"addrs"`
+}
+
+func parseAndroidNetworkInterfaces(data string) ([]netmon.Interface, error) {
+	var snapshot []androidNetworkInterface
+	if err := json.Unmarshal([]byte(data), &snapshot); err != nil {
+		return nil, fmt.Errorf("invalid Android interface snapshot: %w", err)
+	}
+	interfaces := make([]netmon.Interface, 0, len(snapshot))
+	for _, value := range snapshot {
+		if value.Name == "" || value.Index < 0 || value.MTU < 0 {
+			return nil, fmt.Errorf("invalid Android interface metadata")
+		}
+		standard := &net.Interface{Name: value.Name, Index: value.Index, MTU: value.MTU}
+		if value.Up {
+			standard.Flags |= net.FlagUp
+		}
+		if value.Broadcast {
+			standard.Flags |= net.FlagBroadcast
+		}
+		if value.Loopback {
+			standard.Flags |= net.FlagLoopback
+		}
+		if value.PointToPoint {
+			standard.Flags |= net.FlagPointToPoint
+		}
+		if value.Multicast {
+			standard.Flags |= net.FlagMulticast
+		}
+		addresses := make([]net.Addr, 0, len(value.Addrs))
+		for _, address := range value.Addrs {
+			ip, err := netip.ParseAddr(address.IP)
+			if err != nil {
+				return nil, fmt.Errorf("invalid Android interface address %q: %w", address.IP, err)
+			}
+			bits := 128
+			if ip.Is4() {
+				bits = 32
+			}
+			if address.PrefixLen < 0 || address.PrefixLen > bits {
+				return nil, fmt.Errorf("invalid Android prefix length %d", address.PrefixLen)
+			}
+			mask := net.CIDRMask(address.PrefixLen, bits)
+			addresses = append(addresses, &net.IPNet{IP: net.IP(ip.AsSlice()), Mask: mask})
+		}
+		interfaces = append(interfaces, netmon.Interface{Interface: standard, AltAddrs: addresses})
+	}
+	return interfaces, nil
+}
diff --git a/android_network_test.go b/android_network_test.go
new file mode 100644
index 0000000..dbef702
--- /dev/null
+++ b/android_network_test.go
@@ -0,0 +1,33 @@
+package main
+
+import (
+	"net"
+	"testing"
+)
+
+func TestParseAndroidNetworkInterfaces(t *testing.T) {
+	interfaces, err := parseAndroidNetworkInterfaces(`[{"name":"wlan0","index":30,"mtu":1500,"up":true,"broadcast":true,"loopback":false,"pointToPoint":false,"multicast":true,"addrs":[{"ip":"10.1.10.131","prefixLen":24},{"ip":"fe80::1%wlan0","prefixLen":64}]}]`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(interfaces) != 1 || interfaces[0].Name != "wlan0" {
+		t.Fatalf("unexpected interfaces: %+v", interfaces)
+	}
+	if interfaces[0].Flags&net.FlagUp == 0 || interfaces[0].Flags&net.FlagMulticast == 0 {
+		t.Fatalf("missing interface flags: %v", interfaces[0].Flags)
+	}
+	addresses, err := interfaces[0].Addrs()
+	if err != nil || len(addresses) != 2 {
+		t.Fatalf("unexpected addresses: %v, %v", addresses, err)
+	}
+	if got := addresses[0].String(); got != "10.1.10.131/24" {
+		t.Fatalf("first address = %q", got)
+	}
+}
+
+func TestParseAndroidNetworkInterfacesRejectsInvalidAddress(t *testing.T) {
+	_, err := parseAndroidNetworkInterfaces(`[{"name":"wlan0","index":1,"mtu":1500,"up":true,"addrs":[{"ip":"invalid","prefixLen":24}]}]`)
+	if err == nil {
+		t.Fatal("invalid address accepted")
+	}
+}
