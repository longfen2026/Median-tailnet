+//export TsnetSetAndroidNetwork
+func TsnetSetAndroidNetwork(sd C.int, interfacesJSON, defaultInterface *C.char) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	if s.started {
+		return s.recErr(fmt.Errorf("Android network snapshot must be set before start"))
+	}
+	interfaces, err := parseAndroidNetworkInterfaces(C.GoString(interfacesJSON))
+	if err != nil {
+		return s.recErr(err)
+	}
+	if len(interfaces) == 0 {
+		return s.recErr(fmt.Errorf("Android network snapshot contains no interfaces"))
+	}
+	s.androidInterfaces = interfaces
+	s.androidDefaultRoute = C.GoString(defaultInterface)
+	return s.recErr(nil)
+}
+
+//export TsnetUpdateAndroidNetwork
+func TsnetUpdateAndroidNetwork(sd C.int, interfacesJSON, defaultInterface *C.char) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	interfaces, err := parseAndroidNetworkInterfaces(C.GoString(interfacesJSON))
+	if err != nil {
+		return s.recErr(err)
+	}
+	if len(interfaces) == 0 {
+		return s.recErr(fmt.Errorf("Android network snapshot contains no interfaces"))
+	}
+	s.androidNetworkMu.Lock()
+	s.androidInterfaces = interfaces
+	defaultRoute := C.GoString(defaultInterface)
+	s.androidDefaultRoute = defaultRoute
+	s.androidNetworkMu.Unlock()
+	netmon.UpdateLastKnownDefaultRouteInterface(defaultRoute)
+	serverValue := reflect.ValueOf(s.s)
+	if !serverValue.IsNil() {
+		monitorField := serverValue.Elem().FieldByName("netMon")
+		if monitorField.IsValid() && !monitorField.IsNil() {
+			monitor := *(**netmon.Monitor)(unsafe.Pointer(monitorField.UnsafeAddr()))
+			monitor.InjectEvent()
+		}
+	}
+	return s.recErr(nil)
+}
